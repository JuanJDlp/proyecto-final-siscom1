    {"id": 3, "type": "stat", "title": "Mensajes recibidos (5 min)",
      "datasource": {"type": "influxdb", "uid": "agro-influxdb-processed"},
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 1},
      "fieldConfig": {"defaults": {
        "unit": "short", "color": {"mode": "thresholds"},
        "thresholds": {"mode": "absolute", "steps": [
          {"color": "red", "value": null}, {"color": "orange", "value": 5}, {"color": "green", "value": 20}
        ]}}},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "area"},
      "targets": [{
        "refId": "A",
        "datasource": {"type": "influxdb", "uid": "agro-influxdb-processed"},
        "query": "from(bucket: \"agro_iot_processed\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"sensor_data\")\n  |> filter(fn: (r) => r._field == \"temperature_air\")\n  |> count()\n  |> group()\n  |> sum()"
      }]
    },

    {"id": 4, "type": "stat", "title": "Quality score promedio",
      "datasource": {"type": "influxdb", "uid": "agro-influxdb-processed"},
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 1},
      "fieldConfig": {"defaults": {
        "unit": "percentunit", "min": 0, "max": 1, "color": {"mode": "thresholds"},
        "thresholds": {"mode": "absolute", "steps": [
          {"color": "red", "value": null}, {"color": "orange", "value": 0.5}, {"color": "yellow", "value": 0.75}, {"color": "green", "value": 0.9}
        ]}}},
      "options": {"reduceOptions": {"calcs": ["mean"]}, "colorMode": "background", "graphMode": "area"},
      "targets": [{
        "refId": "A",
        "datasource": {"type": "influxdb", "uid": "agro-influxdb-processed"},
        "query": "from(bucket: \"agro_iot_processed\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r._measurement == \"sensor_data\")\n  |> filter(fn: (r) => r._field == \"quality_score\")\n  |> mean()\n  |> group()\n  |> mean()"
      }]
    },

