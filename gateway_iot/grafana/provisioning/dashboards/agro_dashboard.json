          {"matcher": {"id": "byName", "options": "Time"},
           "properties": [{"id": "displayName", "value": "Fecha/Hora"}, {"id": "custom.width", "value": 160}]},
          {"matcher": {"id": "byName", "options": "parcela"},
           "properties": [{"id": "displayName", "value": "Parcela"}, {"id": "custom.width", "value": 100}]},
          {"matcher": {"id": "byName", "options": "cultivo"},
           "properties": [{"id": "displayName", "value": "Cultivo"}, {"id": "custom.width", "value": 100},
             {"id": "mappings", "value": [{"type": "value", "options": {"sugarcane": {"text": "Caña"}, "oil_palm": {"text": "Palma"}}}]}]},
          {"matcher": {"id": "byName", "options": "variable"},
           "properties": [{"id": "displayName", "value": "Variable"}, {"id": "custom.width", "value": 150}]},
          {"matcher": {"id": "byName", "options": "severity"},
           "properties": [{"id": "displayName", "value": "Severidad"}, {"id": "custom.width", "value": 100},
             {"id": "custom.displayMode", "value": "color-background"},
             {"id": "mappings", "value": [{"type": "value", "options": {"critical": {"color": "red", "text": "CRITICAL"}, "warning": {"color": "orange", "text": "WARNING"}}}]}]},
          {"matcher": {"id": "byName", "options": "threshold_type"},
           "properties": [{"id": "displayName", "value": "Tipo"}, {"id": "custom.width", "value": 80},
             {"id": "mappings", "value": [{"type": "value", "options": {"high": {"text": "Alto"}, "low": {"text": "Bajo"}}}]}]},
          {"matcher": {"id": "byName", "options": "Value"},
           "properties": [{"id": "displayName", "value": "Valor sensor"}, {"id": "decimals", "value": 2}]}
        ]},
