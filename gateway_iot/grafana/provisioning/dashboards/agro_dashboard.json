        "enable": true,
        "hide": false,
        "iconColor": "red",
        "name": "Alertas IoT",
        "rawQuery": "from(bucket: \"agro_iot_alerts\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"alert_events\")\n  |> filter(fn: (r) => r._field == \"value\")\n  |> keep(columns: [\"_time\", \"parcela\", \"variable\", \"severity\", \"_value\"])",
        "showIn": 0,
        "step": "60s",
        "textColumn": "variable",
        "titleColumn": "parcela",
        "type": "tags"
      }
    ]
  },
  "description": "Monitoreo agroclimático IoT en tiempo real — Fases 4, 5 y 7",
