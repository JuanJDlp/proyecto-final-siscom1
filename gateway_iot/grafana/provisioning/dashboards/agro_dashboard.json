    "list": [
      {
        "name": "parcela",
        "label": "Parcela",
        "type": "query",
        "datasource": {"type": "influxdb", "uid": "agro-influxdb-processed"},
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"agro_iot_processed\", tag: \"parcela\")",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "current": {"text": "All", "value": "$__all"}
      },
      {
        "name": "cultivo",
        "label": "Cultivo",
        "type": "query",
        "datasource": {"type": "influxdb", "uid": "agro-influxdb-processed"},
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"agro_iot_processed\", tag: \"cultivo\")",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "current": {"text": "All", "value": "$__all"}
      }
    ]
  },
  "panels": [
    {"collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}, "id": 1000,
